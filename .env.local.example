# Copy this file to .env.local and fill in the values you want to use locally.

# Free EIA API key for live gas prices — register at https://www.eia.gov/opendata/register.php
VITE_EIA_API_KEY=

# Optional — Mapbox Search Box token, improves address/POI autocomplete accuracy.
# Get one at https://account.mapbox.com/access-tokens
VITE_MAPBOX_TOKEN=

# The app runs fully without either of these — it falls back to static 2024
# gas price averages and OSM/Census geocoding when they're unset.
